[Unit]
Description=GPU Power Management on Screen Lock Events
PartOf=graphical-session.target
After=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
ExecStart=/usr/bin/gpu-power-manager
# Safety net for SIGKILL / panic=abort: never leave the GPU throttled
ExecStopPost=/bin/sh -c 'for f in /sys/bus/pci/devices/*/power_dpm_force_performance_level; do [ -w "$$f" ] && echo auto > "$$f"; done; exit 0'
Restart=on-failure
RestartSec=3
MemoryMax=32M

# Sandboxing
ProtectSystem=strict
ProtectHome=read-only
NoNewPrivileges=true
# Must stay false: we write to /sys
ProtectKernelTunables=false
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
PrivateTmp=true
LockPersonality=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX
MemoryDenyWriteExecute=true

[Install]
WantedBy=graphical-session.target
